# Production Dockerfile for VisionX Next.js 16 Frontend
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace and package manifests
COPY package.json package-lock.json ./
COPY frontend/landing_page/package.json ./frontend/landing_page/

RUN npm ci

# Copy frontend source code
COPY frontend/landing_page ./frontend/landing_page

# Accept backend URL at build time for static generation
ARG NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app/frontend/landing_page
RUN npm run build

# Runner stage
FROM node:20-alpine AS runner

WORKDIR /app/frontend/landing_page

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/package.json /app/package.json
COPY --from=builder /app/frontend/landing_page ./

EXPOSE 3000

CMD ["npm", "run", "start"]
